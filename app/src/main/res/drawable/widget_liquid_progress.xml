<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Glass Track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#25FFFFFF" />
            <stroke android:width="0.75dp" android:color="#35FFFFFF" />
        </shape>
    </item>
    <!-- Progress Glowing Liquid Gradient -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#38BDF8"
                    android:centerColor="#818CF8"
                    android:endColor="#F472B6" />
            </shape>
        </clip>
    </item>
</layer-list>
