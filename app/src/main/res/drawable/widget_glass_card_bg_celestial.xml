<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ambient Fluid Glow Halo (Simulates Glass Diffusion / Blur) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#2838BDF8" />
        </shape>
    </item>

    <!-- 2. Translucent Frosted Glass Acrylic Body -->
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="26.5dp" />
            <gradient
                android:angle="270"
                android:startColor="#800D253F"
                android:centerColor="#700A1A2D"
                android:endColor="#85051220" />
            <stroke
                android:width="1.5dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>

    <!-- 3. Specular Meniscus Curved Highlight -->
    <item android:top="2dp" android:left="3dp" android:right="3dp" android:height="36dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- 4. Subtle Bottom Accent Refraction Tint -->
    <item android:bottom="2dp" android:left="6dp" android:right="6dp" android:height="26dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp"
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp" />
            <gradient
                android:angle="90"
                android:startColor="#3038BDF8"
                android:endColor="#0038BDF8" />
        </shape>
    </item>
</layer-list>
