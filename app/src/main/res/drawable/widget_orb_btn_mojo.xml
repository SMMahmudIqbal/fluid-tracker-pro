<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#24DC2626" />
            <stroke android:width="1.5dp" android:color="#66DC2626" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#DC2626"
                android:centerColor="#B91C1C"
                android:endColor="#7F1D1D" />
        </shape>
    </item>
    <item android:top="3dp" android:left="6dp" android:right="6dp" android:height="16dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:drawable="@drawable/ic_glass_plus" />
</layer-list>
