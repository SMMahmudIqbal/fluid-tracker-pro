<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#280284C7" />
        </shape>
    </item>
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="28.5dp" />
            <gradient
                android:angle="270"
                android:startColor="#80182232"
                android:centerColor="#70121B28"
                android:endColor="#850B121C" />
            <stroke
                android:width="1.5dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:top="2dp" android:left="6dp" android:right="6dp" android:height="18dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
