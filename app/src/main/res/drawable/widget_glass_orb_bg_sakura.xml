<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#20F472B6" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#E61A0D1D"
                android:centerColor="#D9140A17"
                android:endColor="#F20D060F" />
            <stroke
                android:width="1.2dp"
                android:color="#4DF472B6" />
        </shape>
    </item>
    <item android:top="3dp" android:left="12dp" android:right="12dp" android:height="22dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
