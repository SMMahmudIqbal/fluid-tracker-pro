<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#24EF4444" />
            <stroke android:width="1.5dp" android:color="#66EF4444" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#EF4444"
                android:centerColor="#DC2626"
                android:endColor="#991B1B" />
        </shape>
    </item>
    <item android:top="3dp" android:left="6dp" android:right="6dp" android:height="16dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:drawable="@drawable/ic_glass_plus" />
</layer-list>
