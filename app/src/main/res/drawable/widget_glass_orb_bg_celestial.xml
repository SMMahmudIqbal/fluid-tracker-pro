<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ambient Glass Blur Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2E38BDF8" />
        </shape>
    </item>

    <!-- 2. Frosted Glass Translucent Core -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#800D253F"
                android:centerColor="#700A1A2D"
                android:endColor="#85051220" />
            <stroke
                android:width="1.5dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <!-- 3. Upper Specular Lens Reflection Sheen -->
    <item android:top="4dp" android:left="8dp" android:right="8dp" android:height="24dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
