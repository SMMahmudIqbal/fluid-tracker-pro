<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ambient Glass Glow Halo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#2838BDF8" />
        </shape>
    </item>

    <!-- 2. Frosted Glass Capsule Body -->
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="28.5dp" />
            <gradient
                android:angle="270"
                android:startColor="#800D253F"
                android:centerColor="#700A1A2D"
                android:endColor="#85051220" />
            <stroke
                android:width="1.5dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>

    <!-- 3. Specular Curved Top Sheen -->
    <item android:top="2dp" android:left="6dp" android:right="6dp" android:height="18dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
