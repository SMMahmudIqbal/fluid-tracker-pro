<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_card_bg_celestial"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Top Header Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Drink/App Brand Badge -->
        <TextView
            android:id="@+id/widget_drink_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_frosted_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="FLUID PRO"
            android:textColor="#F1F5F9"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Streak Pill -->
        <TextView
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_frosted_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="1D STREAK"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Milestone Badge -->
        <TextView
            android:id="@+id/widget_milestone_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_frosted_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="GOAL MET"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- User Profile Name Display -->
        <TextView
            android:id="@+id/widget_user_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S. M. Mahmud Iqbal"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Main Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left Hydration Stats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/widget_count_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ml"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_count_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="of 2,000 ml (0%)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sleek Horizontal Progress Gauge -->
            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_liquid_progress" />
        </LinearLayout>

        <!-- Right Quick Action: 3D Frosted Glass Orb Button -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center">

            <ImageButton
                android:id="@+id/widget_btn_add"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_orb_btn_water"
                android:contentDescription="Log Drink" />
        </FrameLayout>

    </LinearLayout>

    <!-- Hydration Science Insight Note -->
    <TextView
        android:id="@+id/widget_quote_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Hydration elevates cognitive alertness and regulates cellular metabolic balance."
        android:textColor="#E2E8F0"
        android:textSize="11sp" />

    <!-- Developer Attribution Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text="Developed by S. M. Mahmud Iqbal"
        android:textColor="#64748B"
        android:textSize="9sp" />

</LinearLayout>
