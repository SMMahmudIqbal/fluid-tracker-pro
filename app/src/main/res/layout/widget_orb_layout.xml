<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_orb_bg_celestial">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Progress Percentage Header -->
        <TextView
            android:id="@+id/widget_orb_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Total Volume Readout -->
        <TextView
            android:id="@+id/widget_orb_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 2,000 ml"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 3D Liquid Glass Orb Action Button -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="5dp">

            <ImageButton
                android:id="@+id/widget_btn_add_orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_orb_btn_water"
                android:contentDescription="Quick Log 250ml" />
        </FrameLayout>

        <!-- Quick Log Indicator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="+250ml"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
